rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Require verified ALU email, with one temporary production demo account.
    function isProductionDemoStaff() {
      return request.auth != null &&
        request.auth.token.email == 'livishjonathan@gmail.com' &&
        request.auth.token.email_verified == true;
    }

    function hasVerifiedAluEmail() {
      return request.auth != null &&
        request.auth.token.email is string &&
        request.auth.token.email_verified == true &&
        (
          request.auth.token.email.matches(
            '^[^@]+@(alustudent\\.com|alustaff\\.com)$'
          ) || isProductionDemoStaff()
        );
    }

    function isSignedIn() {
      return hasVerifiedAluEmail();
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function userDocumentExists() {
      return isSignedIn() &&
        exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        );
    }

    function isApprovedStaff() {
      return userDocumentExists() &&
        get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.role == 'staff' &&
        get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.accountStatus == 'active';
    }

    // Demo staff can manage incidents but cannot authorize more staff users.
    function isInstitutionalStaff() {
      return isApprovedStaff() &&
        request.auth.token.email.matches('^[^@]+@alustaff\\.com$');
    }

    function isActiveStudent() {
      return userDocumentExists() &&
        get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.role == 'student' &&
        get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.accountStatus == 'active';
    }

    function canUseIncidents() {
      return isActiveStudent() || isApprovedStaff();
    }

    function validText(value, maxLength) {
      return value is string &&
        value.size() > 0 &&
        value.size() <= maxLength &&
        value.matches('.*\\S.*');
    }

    function validPhotoUrl(value) {
      return value == null ||
        (
          value is string &&
          value.size() <= 2048 &&
          value.matches(
            '^https://res\\.cloudinary\\.com/vbzq5ssu/image/upload/.+$'
          )
        );
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isApprovedStaff();

      allow create: if isOwner(userId) &&
        request.resource.data.email == request.auth.token.email &&
        request.resource.data.keys().hasAll([
          'email',
          'role',
          'accountStatus'
        ]) &&
        request.resource.data.keys().hasOnly([
          'name',
          'displayName',
          'email',
          'role',
          'accountStatus',
          'photoUrl',
          'createdAt'
        ]) &&
        (
          !request.resource.data.keys().hasAny(['photoUrl']) ||
          validPhotoUrl(request.resource.data.photoUrl)
        ) &&
        (
          (
            request.resource.data.role == 'student' &&
            request.resource.data.accountStatus == 'active'
          ) ||
          (
            request.resource.data.role == 'pending_staff' &&
            request.resource.data.accountStatus == 'pending'
          ) ||
          (
            isProductionDemoStaff() &&
            request.resource.data.email == request.auth.token.email &&
            request.resource.data.role == 'staff' &&
            request.resource.data.accountStatus == 'active'
          )
        );

      allow update: if isOwner(userId) &&
        request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly(['name', 'displayName', 'photoUrl']) &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.accountStatus == resource.data.accountStatus &&
        request.resource.data.email == resource.data.email &&
        (
          !request.resource.data.keys().hasAny(['photoUrl']) ||
          validPhotoUrl(request.resource.data.photoUrl)
        );

      allow update: if isInstitutionalStaff() &&
        resource.data.role == 'pending_staff' &&
        resource.data.accountStatus == 'pending' &&
        request.resource.data.role == 'staff' &&
        request.resource.data.accountStatus == 'active' &&
        request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly(['role', 'accountStatus']);

      allow delete: if false;

      match /reported_incidents/{incidentId} {
        allow read: if isOwner(userId) && isActiveStudent();

        allow create: if isOwner(userId) &&
          isActiveStudent() &&
          request.resource.data.keys().hasAll([
            'incidentId',
            'createdAt'
          ]) &&
          request.resource.data.keys().hasOnly([
            'incidentId',
            'createdAt'
          ]) &&
          request.resource.data.incidentId == incidentId &&
          request.resource.data.createdAt == request.time &&
          existsAfter(
            /databases/$(database)/documents/incidents/$(incidentId)
          );

        allow update, delete: if false;
      }
    }

    match /incidents/{incidentId} {
      allow read: if canUseIncidents();

      allow create: if isActiveStudent() &&
        request.resource.data.keys().hasAll([
          'category',
          'location',
          'description',
          'status',
          'photoUrl',
          'createdAt',
          'updatedAt'
        ]) &&
        request.resource.data.keys().hasOnly([
          'category',
          'location',
          'description',
          'status',
          'photoUrl',
          'createdAt',
          'updatedAt'
        ]) &&
        validText(request.resource.data.category, 100) &&
        validText(request.resource.data.location, 200) &&
        validText(request.resource.data.description, 2000) &&
        request.resource.data.status == 'pending' &&
        validPhotoUrl(request.resource.data.photoUrl) &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time &&
        existsAfter(
          /databases/$(database)/documents/incident_reporters/$(incidentId)
        ) &&
        getAfter(
          /databases/$(database)/documents/incident_reporters/$(incidentId)
        ).data.reporterId == request.auth.uid &&
        getAfter(
          /databases/$(database)/documents/incident_reporters/$(incidentId)
        ).data.incidentId == incidentId &&
        existsAfter(
          /databases/$(database)/documents/users/$(request.auth.uid)/reported_incidents/$(incidentId)
        );

      allow update: if isApprovedStaff() &&
        request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly(['status', 'updatedAt']) &&
        request.resource.data.status in [
          'pending',
          'reviewed',
          'in_progress',
          'resolved'
        ] &&
        request.resource.data.updatedAt == request.time;

      allow delete: if false;

      match /comments/{commentId} {
        allow read: if canUseIncidents();

        allow create: if canUseIncidents() &&
          request.resource.data.keys().hasAll([
            'incidentId',
            'message',
            'createdAt'
          ]) &&
          request.resource.data.keys().hasOnly([
            'incidentId',
            'message',
            'createdAt'
          ]) &&
          request.resource.data.incidentId == incidentId &&
          validText(request.resource.data.message, 2000) &&
          request.resource.data.createdAt == request.time &&
          existsAfter(
            /databases/$(database)/documents/incident_comment_authors/$(commentId)
          ) &&
          getAfter(
            /databases/$(database)/documents/incident_comment_authors/$(commentId)
          ).data.authorId == request.auth.uid &&
          getAfter(
            /databases/$(database)/documents/incident_comment_authors/$(commentId)
          ).data.incidentId == incidentId &&
          getAfter(
            /databases/$(database)/documents/incident_comment_authors/$(commentId)
          ).data.commentId == commentId;

        allow update, delete: if false;
      }
    }

    match /incident_reporters/{incidentId} {
      allow read: if isApprovedStaff();

      allow create: if isActiveStudent() &&
        request.resource.data.keys().hasAll([
          'incidentId',
          'reporterId',
          'reporterName',
          'reporterEmail',
          'createdAt'
        ]) &&
        request.resource.data.keys().hasOnly([
          'incidentId',
          'reporterId',
          'reporterName',
          'reporterEmail',
          'createdAt'
        ]) &&
        request.resource.data.incidentId == incidentId &&
        request.resource.data.reporterId == request.auth.uid &&
        request.resource.data.createdAt == request.time &&
        existsAfter(
          /databases/$(database)/documents/incidents/$(incidentId)
        ) &&
        getAfter(
          /databases/$(database)/documents/incidents/$(incidentId)
        ).data.status == 'pending';

      allow update, delete: if false;
    }

    match /incident_comment_authors/{commentId} {
      allow read: if isApprovedStaff();

      allow create: if canUseIncidents() &&
        request.resource.data.keys().hasAll([
          'commentId',
          'incidentId',
          'authorId',
          'authorName',
          'authorEmail',
          'createdAt'
        ]) &&
        request.resource.data.keys().hasOnly([
          'commentId',
          'incidentId',
          'authorId',
          'authorName',
          'authorEmail',
          'createdAt'
        ]) &&
        request.resource.data.commentId == commentId &&
        request.resource.data.authorId == request.auth.uid &&
        request.resource.data.createdAt == request.time &&
        existsAfter(
          /databases/$(database)/documents/incidents/$(request.resource.data.incidentId)/comments/$(commentId)
        ) &&
        getAfter(
          /databases/$(database)/documents/incidents/$(request.resource.data.incidentId)/comments/$(commentId)
        ).data.incidentId == request.resource.data.incidentId;

      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
