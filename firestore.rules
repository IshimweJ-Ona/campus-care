rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userPath(userId) {
      return /databases/$(database)/documents/users/$(userId);
    }

    function hasUserProfile() {
      return signedIn() &&
        exists(userPath(request.auth.uid));
    }

    function isActiveStudent() {
      return hasUserProfile() &&
        get(userPath(request.auth.uid)).data.role == 'student' &&
        get(userPath(request.auth.uid)).data.accountStatus == 'active';
    }

    function isApprovedStaff() {
      return hasUserProfile() &&
        get(userPath(request.auth.uid)).data.role == 'staff' &&
        get(userPath(request.auth.uid)).data.accountStatus == 'active';
    }

    function isActiveCampusMember() {
      return isActiveStudent() || isApprovedStaff();
    }

    function validStatus(status) {
      return status in ['pending', 'reviewed', 'in_progress', 'resolved'];
    }

    function reporterPath(incidentId) {
      return /databases/$(database)/documents/incident_reporters/$(incidentId);
    }

    function userIncidentPath(userId, incidentId) {
      return /databases/$(database)/documents/users/$(userId)/reported_incidents/$(incidentId);
    }

    function validIncidentCreate(incidentId) {
      let reporter = getAfter(reporterPath(incidentId)).data;
      let userIncident = getAfter(
        userIncidentPath(request.auth.uid, incidentId)
      ).data;
      return request.resource.data.keys().hasOnly([
          'category',
          'location',
          'description',
          'status',
          'photoUrl',
          'createdAt',
          'updatedAt'
        ]) &&
        request.resource.data.keys().hasAll([
          'category',
          'location',
          'description',
          'status',
          'photoUrl',
          'createdAt',
          'updatedAt'
        ]) &&
        request.resource.data.category is string &&
        request.resource.data.location is string &&
        request.resource.data.description is string &&
        request.resource.data.status == 'pending' &&
        (request.resource.data.photoUrl == null ||
          request.resource.data.photoUrl is string) &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time &&
        reporter.incidentId == incidentId &&
        reporter.reporterId == request.auth.uid &&
        userIncident.incidentId == incidentId;
    }

    match /users/{userId} {
      allow get: if signedIn() && request.auth.uid == userId;
      allow list: if false;

      allow create: if signedIn() &&
        request.auth.uid == userId &&
        request.resource.data.keys().hasOnly([
          'name',
          'email',
          'photoUrl',
          'role',
          'accountStatus',
          'createdAt'
        ]) &&
        request.resource.data.keys().hasAll([
          'name',
          'email',
          'photoUrl',
          'role',
          'accountStatus',
          'createdAt'
        ]) &&
        request.resource.data.name is string &&
        request.resource.data.email is string &&
        (request.resource.data.photoUrl == null ||
          request.resource.data.photoUrl is string) &&
        (
          (request.resource.data.role == 'student' &&
            request.resource.data.accountStatus == 'active') ||
          (request.resource.data.role == 'pending_staff' &&
            request.resource.data.accountStatus == 'pending')
        ) &&
        request.resource.data.createdAt == request.time;

      allow update: if signedIn() &&
        request.auth.uid == userId &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'photoUrl']) &&
        request.resource.data.name is string &&
        (request.resource.data.photoUrl == null ||
          request.resource.data.photoUrl is string);
      allow delete: if false;

      match /reported_incidents/{incidentId} {
        allow get, list: if signedIn() && request.auth.uid == userId;
        allow create: if isActiveStudent() &&
          request.auth.uid == userId &&
          request.resource.data.keys().hasOnly(['incidentId', 'createdAt']) &&
          request.resource.data.keys().hasAll(['incidentId', 'createdAt']) &&
          request.resource.data.incidentId == incidentId &&
          request.resource.data.createdAt == request.time &&
          getAfter(
            /databases/$(database)/documents/incidents/$(incidentId)
          ).data.status == 'pending' &&
          getAfter(reporterPath(incidentId)).data.reporterId == userId;
        allow update, delete: if false;
      }
    }

    match /incidents/{incidentId} {
      allow get, list: if isActiveCampusMember();
      allow create: if isActiveStudent() &&
        validIncidentCreate(incidentId);
      allow update: if isApprovedStaff() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'updatedAt']) &&
        validStatus(request.resource.data.status) &&
        request.resource.data.updatedAt == request.time;
      allow delete: if false;

      match /comments/{commentId} {
        allow get, list: if isActiveCampusMember();
        allow create: if isActiveCampusMember() &&
          request.resource.data.keys().hasOnly([
            'incidentId',
            'message',
            'createdAt'
          ]) &&
          request.resource.data.keys().hasAll([
            'incidentId',
            'message',
            'createdAt'
          ]) &&
          request.resource.data.incidentId == incidentId &&
          request.resource.data.message is string &&
          request.resource.data.message.size() > 0 &&
          request.resource.data.createdAt == request.time &&
          getAfter(
            /databases/$(database)/documents/incident_comment_authors/$(commentId)
          ).data.incidentId == incidentId &&
          getAfter(
            /databases/$(database)/documents/incident_comment_authors/$(commentId)
          ).data.authorId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    match /incident_reporters/{incidentId} {
      allow get, list: if isApprovedStaff();
      allow create: if isActiveStudent() &&
        request.resource.data.keys().hasOnly([
          'incidentId',
          'reporterId',
          'reporterName',
          'reporterEmail',
          'reporterPhotoUrl',
          'createdAt'
        ]) &&
        request.resource.data.keys().hasAll([
          'incidentId',
          'reporterId',
          'reporterName',
          'reporterEmail',
          'reporterPhotoUrl',
          'createdAt'
        ]) &&
        request.resource.data.incidentId == incidentId &&
        request.resource.data.reporterId == request.auth.uid &&
        request.resource.data.reporterName ==
          get(userPath(request.auth.uid)).data.name &&
        request.resource.data.reporterEmail ==
          get(userPath(request.auth.uid)).data.email &&
        request.resource.data.reporterPhotoUrl ==
          get(userPath(request.auth.uid)).data.photoUrl &&
        request.resource.data.createdAt == request.time &&
        getAfter(
          /databases/$(database)/documents/incidents/$(incidentId)
        ).data.status == 'pending' &&
        getAfter(
          userIncidentPath(request.auth.uid, incidentId)
        ).data.incidentId == incidentId;
      allow update, delete: if false;
    }

    match /incident_comment_authors/{commentId} {
      allow get, list: if isApprovedStaff();
      allow create: if isActiveCampusMember() &&
        request.resource.data.keys().hasOnly([
          'commentId',
          'incidentId',
          'authorId',
          'authorName',
          'authorEmail',
          'createdAt'
        ]) &&
        request.resource.data.keys().hasAll([
          'commentId',
          'incidentId',
          'authorId',
          'authorName',
          'authorEmail',
          'createdAt'
        ]) &&
        request.resource.data.commentId == commentId &&
        request.resource.data.authorId == request.auth.uid &&
        request.resource.data.authorName ==
          get(userPath(request.auth.uid)).data.name &&
        request.resource.data.authorEmail ==
          get(userPath(request.auth.uid)).data.email &&
        request.resource.data.createdAt == request.time &&
        getAfter(
          /databases/$(database)/documents/incidents/$(request.resource.data.incidentId)/comments/$(commentId)
        ).data.incidentId == request.resource.data.incidentId;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}